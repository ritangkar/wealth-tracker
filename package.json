{
  "name": "wealth-os",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Personal + Household Wealth OS - local-first static PWA",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
